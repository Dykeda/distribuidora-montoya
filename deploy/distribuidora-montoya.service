[Unit]
Description=Distribuidora Montoya
After=network.target

[Service]
User=montoya
WorkingDirectory=/home/montoya/distribuidora-montoya
EnvironmentFile=/home/montoya/distribuidora-montoya.env
ExecStart=/home/montoya/distribuidora-montoya/venv/bin/gunicorn -w 2 -b 127.0.0.1:8000 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
